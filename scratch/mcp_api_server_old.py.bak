        with open(req.filepath, 'r', encoding='utf-8') as f:
            return {"status": "success", "content": f.read()}
    except Exception as e:
        return {"status": "error", "message": str(e)}

@app.post("/os/write_file", summary="Write a file to the filesystem")
async def write_file(req: FileWriteRequest):
    """Write content to a file on the filesystem."""
    try:
        # Ensure directory exists
        if os.path.dirname(req.filepath):
            os.makedirs(os.path.dirname(req.filepath), exist_ok=True)
        with open(req.filepath, 'w', encoding='utf-8') as f:
            f.write(req.content)
        return {"status": "success", "message": f"Successfully wrote to {req.filepath}"}
    except Exception as e:
        return {"status": "error", "message": str(e)}

@app.post("/os/write_file_raw", summary="Write a file using delimiter format")
async def write_file_raw(request: Request):
    """
    Expects raw text payload in the format:
    <<<filepath/example.py>>>
    raw content goes here
    >>>
    """
    try:
        raw_body = await request.body()
        text_body = raw_body.decode('utf-8')
        
        # Parse the <<< >>> format
        if text_body.startswith("<<<") and ">>>\n" in text_body:
            # Extract filepath
            end_path_idx = text_body.find(">>>\n")
            filepath = text_body[3:end_path_idx].strip()
            
            # Extract content (everything after the first >>>\n until the final >>>)
            content_start = end_path_idx + 4
            content_end = text_body.rfind("\n>>>")
            
            if content_end == -1: # Fallback if trailing >>> is missing
                content_end = len(text_body)
                
            content = text_body[content_start:content_end]
            
            if os.path.dirname(filepath):
                os.makedirs(os.path.dirname(filepath), exist_ok=True)
            with open(filepath, 'w', encoding='utf-8') as f:
                f.write(content)
                
            return {"status": "success", "message": f"Successfully wrote to {filepath} using delimiter parsing."}
        else:
            return {"status": "error", "message": "Invalid format. Must use <<<filepath>>> content >>> formatting."}
            
    except Exception as e:
        return {"status": "error", "message": str(e)}

