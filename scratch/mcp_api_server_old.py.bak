@app.post("/system/tasks", summary="Create a background task")
async def create_task(req: TaskCreateRequest, background_tasks: BackgroundTasks):
    """Create a background task for long-running operations."""
    global task_counter
    task_counter += 1
    task_id = f"task_{task_counter}"
    
    tasks[task_id] = {
        "task_id": task_id,
        "task_type": req.task_type,
        "parameters": req.parameters,
        "status": "pending",
        "created_at": datetime.now().isoformat(),
        "result": None,
        "error": None
    }
    
    # Simulate task execution (in real implementation, this would call actual functions)
    async def run_task():
        loop = asyncio.get_running_loop()
        try:
            tasks[task_id]["status"] = "running"
            # Placeholder for actual task execution logic
            await asyncio.sleep(2)  # Simulate work
            
            # Offload heavy workloads to the ThreadPoolExecutor to prevent blocking the FastAPI event loop
            if req.task_type == "audiocraft":
                result = await loop.run_in_executor(
                    task_executor, 
                    execute_audiocraft, 
                    req.parameters.get("prompt", ""), 
                    req.parameters.get("duration", 10), 
                    req.parameters.get("style", "ambient electronic")
                )
            elif req.task_type == "langgraph":
                result = await loop.run_in_executor(
                    task_executor, 
                    execute_langgraph, 
                    req.parameters.get("workflow_name", ""), 
                    req.parameters.get("initial_state", {})
                )
            elif req.task_type == "ouroboros":
                result = await loop.run_in_executor(
                    task_executor, 
                    execute_ouroboros,
                    req.parameters.get("prompt", ""),
                    req.parameters.get("filepath", os.path.join(os.path.dirname(__file__), "workspace", "ouroboros_generated.py")),
                    req.parameters.get("max_retries", 3)
                )
            else:
                raise ValueError(f"Unknown task_type: {req.task_type}. Supported: audiocraft, langgraph, ouroboros")

            tasks[task_id]["status"] = "completed"
            tasks[task_id]["result"] = result
            tasks[task_id]["completed_at"] = datetime.now().isoformat()
        except Exception as e:
            tasks[task_id]["status"] = "failed"
            tasks[task_id]["error"] = str(e)
            tasks[task_id]["completed_at"] = datetime.now().isoformat()
    
    background_tasks.add_task(run_task)
    
    return {"status": "success", "task_id": task_id, "message": "Task created and running in background"}

@app.get("/system/tasks/{task_id}", summary="Get task status")
