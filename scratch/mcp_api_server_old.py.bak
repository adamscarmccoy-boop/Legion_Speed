# --- ANSI Terminal Colors ---
class C:
    RESET  = "\033[0m"
    BOLD   = "\033[1m"
    DIM    = "\033[2m"
    CYAN   = "\033[96m"
    GREEN  = "\033[92m"
    YELLOW = "\033[93m"
    RED    = "\033[91m"
    MAGENTA= "\033[95m"
    BLUE   = "\033[94m"
    WHITE  = "\033[97m"
    GRAY   = "\033[90m"

def _method_color(method: str) -> str:
    return {"GET": C.BLUE, "POST": C.GREEN, "DELETE": C.RED, "PUT": C.YELLOW, "PATCH": C.MAGENTA}.get(method, C.WHITE)

def _status_color(code: int) -> str:
    if code < 300: return C.GREEN
    if code < 400: return C.CYAN
    if code < 500: return C.YELLOW
    return C.RED

# --- FastAPI Application ---
@asynccontextmanager
async def lifespan(app: FastAPI):
    port = int(os.getenv("MCP_API_PORT", 8001))
    w = 60
    print(f"\n{C.CYAN}{C.BOLD}{'=' * w}{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  LEGION UNIFIED ONYX  —  API CORE v3.5{C.RESET}")
    print(f"{C.CYAN}{'=' * w}{C.RESET}")
    print(f"  {C.WHITE}Port      {C.RESET}: {C.YELLOW}{port}{C.RESET}")
    print(f"  {C.WHITE}Gemini    {C.RESET}: {C.GREEN if bool(os.getenv('GEMINI_API_KEY')) else C.RED}{'LOADED' if bool(os.getenv('GEMINI_API_KEY')) else 'MISSING'}{C.RESET}")
    print(f"  {C.WHITE}DuckDB    {C.RESET}: {C.GRAY}{os.getenv('DUCKDB_PATH', 'default')}{C.RESET}")
    print(f"  {C.WHITE}LanceDB   {C.RESET}: {C.GRAY}{os.getenv('LANCEDB_PATH', 'default')}{C.RESET}")
    print(f"  {C.WHITE}Ollama    {C.RESET}: {C.GRAY}{os.getenv('OLLAMA_URL', 'http://127.0.0.1:11434/v1')}{C.RESET}")
    print(f"  {C.WHITE}Ollama    {C.RESET}: {C.GRAY}{os.getenv('OLLAMA_URL', 'http://100.113.76.102:11434/v1')}{C.RESET}")
    print(f"  {C.WHITE}Brain     {C.RESET}: {C.GRAY}offline (use /brain/start){C.RESET}")
    print(f"  {C.WHITE}Router    {C.RESET}: {C.GREEN}/tools/execute{C.RESET}")
    print(f"{C.CYAN}{'=' * w}{C.RESET}\n")
    yield
    print(f"\n{C.YELLOW}[LEGION] Shutting down — all systems offline.{C.RESET}\n")

app = FastAPI(
    title="Legion-Unified-Onyx - Total Operation API",
    description="The central command and control API for Legion's cognitive architecture.",
