@app.post("/os/tail_log", summary="Read trailing lines from a file")
async def tail_log(req: TailLogRequest):
    """Read the trailing N lines from a log file for real-time monitoring."""
    try:
        with open(req.filepath, 'r', encoding='utf-8', errors='ignore') as f:
            lines = f.readlines()
            trailing_lines = lines[-req.lines:] if len(lines) > req.lines else lines
            return {
                "status": "success",
                "lines": trailing_lines,
                "total_lines": len(lines)
            }
    except FileNotFoundError:
        return {"status": "error", "message": f"File not found: {req.filepath}"}
    except Exception as e:
        return {"status": "error", "message": str(e)}

def execute_discover_schema(table_name: str, db_type: str):
    """Standalone schema discovery for DuckDB or LanceDB tables."""
    try:
        if db_type == "duckdb":
            import duckdb
            db_path = config.get("services", {}).get("duckdb", {}).get("path", "test.db")
            conn = duckdb.connect(db_path, read_only=True)
            result = conn.execute(f"PRAGMA table_info('{table_name}')").fetchall()
            conn.close()
            columns = [
                {"name": row[1], "type": row[2], "nullable": row[3]}
                for row in result
            ]
            return {"status": "success", "db_type": "duckdb", "table": table_name, "schema": columns}
        elif db_type == "lancedb":
            import lancedb
            db_path = config.get("services", {}).get("lancedb", {}).get("path", "./vectors/lancedb_store")
            db = lancedb.connect(db_path)
            table = db.open_table(table_name)
            schema = table.schema
            schema_dict = {
                "vector_dim": len(schema.fields[0].vector) if hasattr(schema.fields[0], 'vector') else None,
                "fields": [{"name": f.name, "type": str(f.type)} for f in schema.fields]
            }
            return {"status": "success", "db_type": "lancedb", "table": table_name, "schema": schema_dict}
        else:
            return {"status": "error", "message": f"Unsupported db_type: {db_type}. Use 'duckdb' or 'lancedb'."}
    except ImportError as e:
        return {"status": "error", "message": f"Missing dependency: {str(e)}"}
    except Exception as e:
        return {"status": "error", "message": str(e)}

@app.post("/db/discover_schema", summary="Discover database schema")
def discover_schema(req: DiscoverSchemaRequest):
    """Discover schema metadata for DuckDB or LanceDB tables."""
    return execute_discover_schema(req.table_name, req.db_type)

