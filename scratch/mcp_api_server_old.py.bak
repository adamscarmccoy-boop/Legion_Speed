def _get_firestore_client():
    """Lazy singleton: initializes firebase_admin once, returns Firestore client."""
    if not firebase_admin._apps:
        try:
            # Synchronize clock drift with Google's server time to fix JWT signature issues
            import urllib.request
            import time
            import datetime as dt
            try:
                local_before = time.time()
                res = urllib.request.urlopen('https://www.google.com', timeout=5)
                server_date = res.headers['Date']
                server_parsed = dt.datetime.strptime(server_date, '%a, %d %b %Y %H:%M:%S %Z')
                server_now = server_parsed.replace(tzinfo=dt.timezone.utc).timestamp()
                drift_offset = server_now - local_before
                
                print(f"[TIME SYNC] System clock drift is {drift_offset:.2f}s. Please sync your Windows clock natively if Firebase auth fails.")
            except Exception as te:
                print(f"[WARN] Time sync failed: {te}. Proceeding with system clock.")

            if os.path.exists(_SA_KEY):
                print(f"Loading credentials from: {_SA_KEY}")
                cred = credentials.Certificate(_SA_KEY)
                firebase_admin.initialize_app(cred)
            else:
                print("Using environment-default Application Default Credentials (ADC) for Firebase...")
                firebase_admin.initialize_app()
            print("✓ Firebase Admin initialized — project: legiondaw-87798")
        except Exception as e:
            print(f"✗ Firebase Admin init failed: {e}")
            raise
    return fs_module.client()

