# --- Request Logging Middleware ---
@app.middleware("http")
async def log_requests(request: Request, call_next):
    start_time = datetime.now()
    response = await call_next(request)
    duration = (datetime.now() - start_time).total_seconds()

    method = request.method
    path = request.url.path
    status = response.status_code
    client = request.client.host if request.client else "unknown"

    mc = _method_color(method)
    sc = _status_color(status)
    dur_color = C.GREEN if duration < 0.5 else C.YELLOW if duration < 2.0 else C.RED
    ts = datetime.now().strftime("%H:%M:%S")

    print(
        f"  {C.GRAY}{ts}{C.RESET}  "
        f"{mc}{C.BOLD}{method:<6}{C.RESET}  "
        f"{C.WHITE}{path:<40}{C.RESET}  "
        f"{sc}{C.BOLD}{status}{C.RESET}  "
        f"{dur_color}{duration:.3f}s{C.RESET}  "
        f"{C.GRAY}{client}{C.RESET}"
    )

    try:
        plain = f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {method} {path} - {client} - {status} - {duration:.3f}s\n"
        log_path = os.path.join(os.path.dirname(__file__), "data", "logs", "api_access.log")
        os.makedirs(os.path.dirname(log_path), exist_ok=True)
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(plain)
    except Exception:
        pass

    return response


