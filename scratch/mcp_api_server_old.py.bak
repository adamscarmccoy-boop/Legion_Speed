def _get_dna_signature(workspace_id: str = "ADAMSCARMCCOY") -> dict:
    default_dna = {
        'target_bpm': 126.0,
        'target_key': 5,
        'target_sub_bass': -6.0,
        'target_mid_bass': -10.0,
        'target_brightness': 2000.0,
        'target_loudness': -7.0,
        'target_kick_punch': 0.85,
        'target_stereo_width': 0.6,
        'target_energy': 0.8,
        'target_danceability': 0.85,
        'target_valence': 0.6,
        'target_spectral_flux': 0.3,
        'target_percussiveness': 0.35,
        'target_rms': -10.0,
        'target_crest_factor': 11.0,
        'target_dynamic_range': 6.0,
        'target_transient_density': 4.0,
        'target_harmonic_complexity': 0.4,
        'workspace_id': workspace_id # Pass workspace_id through
    }
    # Look for dna_signature.json in the workspace local cache
    sandbox_root = os.getenv("MUSIC_SANDBOX_PATH", r"D:\APP\SANDBOX\sandbox_music_generation")
    cache_path = os.path.join(sandbox_root, f"{workspace_id}_SANDBOX", "local_cache", "dna_signature.json")
    if os.path.exists(cache_path):
        try:
            with open(cache_path, 'r', encoding='utf-8') as f:
                cached = json.load(f)
                default_dna.update(cached)
                print(f"[DNA] Loaded DNA signature from local cache: {cache_path}")
        except Exception as e:
            print(f"[DNA] Warning: Could not read local DNA cache: {e}")
    else:
        print(f"[DNA] Local DNA cache not found at {cache_path}. Using defaults.")
    return default_dna

def apply_low_shelf(y, sr, cutoff_hz=100.0, gain_db=0.0):
    if gain_db == 0.0:
        return y
    from scipy import signal
    import numpy as np
    A = 10 ** (gain_db / 40.0)
    w0 = 2 * np.pi * cutoff_hz / sr
    alpha = np.sin(w0) / 2.0 * np.sqrt(2.0)
    cos_w0 = np.cos(w0)
    two_sqrt_A_alpha = 2.0 * np.sqrt(A) * alpha
    
    b0 = A * ((A + 1.0) - (A - 1.0) * cos_w0 + two_sqrt_A_alpha)
    b1 = 2.0 * A * ((A - 1.0) - (A + 1.0) * cos_w0)
    b2 = A * ((A + 1.0) - (A - 1.0) * cos_w0 - two_sqrt_A_alpha)
    
    a0 = (A + 1.0) + (A - 1.0) * cos_w0 + two_sqrt_A_alpha
    a1 = -2.0 * ((A - 1.0) + (A + 1.0) * cos_w0)
    a2 = (A + 1.0) + (A - 1.0) * cos_w0 - two_sqrt_A_alpha
    
    b = np.array([b0, b1, b2]) / a0
    a = np.array([a0, a1, a2]) / a0
    
    return signal.lfilter(b, a, y)

def apply_high_shelf(y, sr, cutoff_hz=2000.0, gain_db=0.0):
    if gain_db == 0.0:
        return y
    from scipy import signal
    import numpy as np
    A = 10 ** (gain_db / 40.0)
    w0 = 2 * np.pi * cutoff_hz / sr
    alpha = np.sin(w0) / 2.0 * np.sqrt(2.0)
    cos_w0 = np.cos(w0)
    two_sqrt_A_alpha = 2.0 * np.sqrt(A) * alpha
    
    b0 = A * ((A + 1.0) + (A - 1.0) * cos_w0 + two_sqrt_A_alpha)
    b1 = -2.0 * A * ((A - 1.0) + (A + 1.0) * cos_w0)
    b2 = A * ((A + 1.0) + (A - 1.0) * cos_w0 - two_sqrt_A_alpha)
    
    a0 = (A + 1.0) - (A - 1.0) * cos_w0 + two_sqrt_A_alpha
    a1 = 2.0 * ((A - 1.0) - (A + 1.0) * cos_w0)
    a2 = (A + 1.0) - (A - 1.0) * cos_w0 - two_sqrt_A_alpha
    
    b = np.array([b0, b1, b2]) / a0
    a = np.array([a0, a1, a2]) / a0
    
    return signal.lfilter(b, a, y)

# === AUDIO MASTERING ENDPOINT ===
@app.post("/master-audio")
def master_audio(file: UploadFile, target_lufs: float = -14.0, compression: float = 50.0, workspace_id: str = "ADAMSCARMCCOY"):
    """Master audio using DNA specifications with improved quality"""
    import time
    filename = f"master_input_{int(time.time())}_{file.filename}"
    input_path = os.path.join(MASTERED_DIR, filename)
    
    # Save uploaded file
    with open(input_path, "wb") as buffer:
        shutil.copyfileobj(file.file, buffer)
    
    try:
        import librosa
        import soundfile as sf
        import numpy as np
        from scipy import signal
        
        # Load DNA signature
        dna = _get_dna_signature(workspace_id)
        
        # Override default -14.0 target LUFS with DNA target_loudness (e.g. -7.0)
        effective_lufs = target_lufs
        if target_lufs == -14.0 and "target_loudness" in dna:
            effective_lufs = dna["target_loudness"]
            print(f"[DNA] Overrode target LUFS to DNA target_loudness: {effective_lufs}")
            
        # Load audio with original sample rate
        y, sr = librosa.load(input_path, sr=None)
        
        # Apply gentle high-pass filter to remove subsonic frequencies
        nyquist = sr / 2
        low_cutoff = 20 / nyquist
        b, a = signal.butter(4, low_cutoff, btype='high')
        y_filtered = signal.filtfilt(b, a, y)
        
        # Apply gentle low-pass filter to prevent aliasing
        high_cutoff = 20000 / nyquist
        b, a = signal.butter(4, high_cutoff, btype='low')
        y_filtered = signal.filtfilt(b, a, y_filtered)
        
        # Apply DNA EQ curves
        # Sub-bass low-shelf filter (frequencies below 100 Hz) using target_sub_bass
        sub_bass_gain = max(-3.0, min(3.0, dna.get('target_sub_bass', -6.0) + 6.0 + 1.5))
        if sub_bass_gain != 0.0:
            print(f"[DNA] Applying Low-Shelf Sub-Bass EQ: {sub_bass_gain:+.2f} dB @ 100Hz")
            y_filtered = apply_low_shelf(y_filtered, sr, cutoff_hz=100.0, gain_db=sub_bass_gain)
            
        # Brightness high-shelf filter (frequencies above 2000 Hz) using target_brightness
        brightness_val = dna.get('target_brightness', 2000.0)
        brightness_gain = max(-2.0, min(2.0, (brightness_val - 2000.0) / 1000.0 + 0.5))
        if brightness_gain != 0.0:
            print(f"[DNA] Applying High-Shelf Brightness EQ: {brightness_gain:+.2f} dB @ 2000Hz")
            y_filtered = apply_high_shelf(y_filtered, sr, cutoff_hz=2000.0, gain_db=brightness_gain)
        
        # Apply smooth loudness normalization using effective LUFS
        current_rms = np.sqrt(np.mean(y_filtered**2))
        target_rms = 10 ** (effective_lufs / 20)  # Convert LUFS to RMS
        gain = target_rms / (current_rms + 1e-10)
        
        # Limit gain to prevent excessive amplification
        gain = min(gain, 10.0)
        y_normalized = y_filtered * gain
        
        # Apply soft knee compression with smoothing
        # Adapt base ratio from DNA dynamic range (e.g. 12/6 = 2.0:1)
        dna_dyn_range = dna.get('target_dynamic_range', 6.0)
        base_ratio = max(1.5, 12.0 / dna_dyn_range)
        compression_ratio = base_ratio * (compression / 50.0)
        compression_ratio = max(1.1, min(compression_ratio, 5.0))
        print(f"[DNA] Dynamic Compression Ratio applied: {compression_ratio:.2f}:1")
        
        threshold = np.percentile(np.abs(y_normalized), 75)
        knee_width = threshold * 0.1
        
        # Soft knee compression
        abs_signal = np.abs(y_normalized)
        compressed_signal = np.zeros_like(abs_signal)
        
        for i in range(len(abs_signal)):
            if abs_signal[i] < threshold - knee_width:
                compressed_signal[i] = abs_signal[i]
            elif abs_signal[i] < threshold + knee_width:
                # Soft knee region
                x = (abs_signal[i] - (threshold - knee_width)) / (2 * knee_width)
                compressed_signal[i] = threshold + (abs_signal[i] - threshold) * (1 + (compression_ratio - 1) * x) / compression_ratio
            else:
                # Above threshold
                compressed_signal[i] = threshold + (abs_signal[i] - threshold) / compression_ratio
        
        y_compressed = np.sign(y_normalized) * compressed_signal
        
        # Apply gentle limiting to prevent clipping
        limit_threshold = 0.95
        y_limited = np.tanh(y_compressed / limit_threshold) * limit_threshold
        
        # Apply final normalization to ensure clean output
        max_val = np.max(np.abs(y_limited))
        if max_val > 0.9:
            y_final = y_limited / max_val * 0.9
        else:
            y_final = y_limited
        
        # Preserve input file format and extension dynamically
        _, ext = os.path.splitext(file.filename)
        ext = ext.lower()
        output_filename = f"mastered_{int(time.time())}_{file.filename}"
        output_path = os.path.join(MASTERED_DIR, output_filename)
        
        if ext in ['.wav', '.wave']:
            sf.write(output_path, y_final, sr, subtype='PCM_24', format='WAV')  # Write 24-bit WAV
        elif ext == '.mp3':
            sf.write(output_path, y_final, sr, format='MP3')  # Write MP3
        else:
            sf.write(output_path, y_final, sr)
        
        return {
            "filename": output_filename,
            "path": f"/mastered/{output_filename}",
            "target_lufs": effective_lufs,
            "compression": compression,
            "applied_gain_db": float(20 * np.log10(gain)),
            "sample_rate": sr
        }
    
    except Exception as e:
        return {"error": str(e)}

# ==========================================
# GENERIC MCP TOOL ROUTER (Cloud Orchestrator Bridge)
# ==========================================

@app.post("/tools/execute", summary="Execute a tool via generic MCP payload")
async def execute_tool(req: ToolExecuteRequest):
    """Receives a tool call JSON payload from OpenClaw/DeepSeek and routes to local functions."""
    tool_name = req.tool_name
    params = req.parameters
    print(f"🔧 [MCP TOOL] Executing '{tool_name}' with params: {params}")
    try:
        if tool_name == "get_system_status":
            return get_system_status()
        elif tool_name == "query_lancedb":
            return execute_lancedb_query(
                params.get("table_name", "audio_vibe_gpu"),
                params.get("query_vector_description", ""),
                params.get("limit", 10),
                params.get("cluster_name")
            )
        elif tool_name == "query_duckdb":
            return execute_duckdb_query(
                params.get("sql_query", "SELECT 1"),
                params.get("cluster_name")
            )
        elif tool_name == "generate_audio":
            return execute_audiocraft(
                params.get("text_prompt", ""),
                params.get("duration", 10),
                params.get("style", "ambient electronic")
            )
        elif tool_name == "inference_phi":
            return execute_phi_inference(
                params.get("prompt", ""),
                params.get("context", "")
            )
        elif tool_name == "inference_openai":
            return execute_openai_inference(
                params.get("prompt", ""),
                params.get("context", ""),
                params.get("model", "google/gemma-4-26b-a4b-it:free")
            )
        elif tool_name == "run_workflow":
            return execute_langgraph(
                params.get("workflow_name", ""),
                params.get("initial_state", {})
            )
        elif tool_name == "chat_v4":
            # Auto-start brain if needed and route the message
            if not _brain_process or _brain_process.poll() is not None:
                brain_start()
                import time; time.sleep(2)
            prompt = params.get("message", params.get("prompt", ""))
            print(f"🧠 Routing to Brain (v4): {prompt[:50]}...")
            async with httpx.AsyncClient(timeout=120) as client:
                resp = await client.post(f"http://localhost:{_BRAIN_PORT}/chat", json={"messages": [{"role": "user", "content": prompt}]})
                return {"status": "success", "response": resp.text}
        elif tool_name == "read_file":
            with open(params.get("filepath", ""), 'r', encoding='utf-8') as f:
                return {"status": "success", "content": f.read()}
        elif tool_name == "write_file":
            fp = params.get("filepath", "")
            if os.path.dirname(fp):
                os.makedirs(os.path.dirname(fp), exist_ok=True)
            with open(fp, 'w', encoding='utf-8') as f:
                f.write(params.get("content", ""))
            return {"status": "success", "message": f"Wrote to {fp}"}
        elif tool_name == "execute_shell":
            result = subprocess.run(params.get("command", ""), shell=True, capture_output=True, text=True)
            return {"status": "success" if result.returncode == 0 else "warning", "stdout": result.stdout, "stderr": result.stderr, "returncode": result.returncode}
        elif tool_name == "find_files":
            files = glob.glob(params.get("pattern", ""), recursive=True)
            return {"status": "success", "files": files}
        elif tool_name == "discover_schema":
            return execute_discover_schema(params.get("table_name", ""), params.get("db_type", "duckdb"))
        else:
            return {"status": "error", "message": f"Unknown tool_name: {tool_name}"}
    except Exception as e:
        print(f"Tool execution error: {e}")
        return {"status": "error", "message": str(e)}
        
@app.post("/chat", summary="Simple chat endpoint for legacy UIs")
def simple_chat(req: SimpleChatRequest):
    """Provides a basic, non-streaming chat interface for compatibility."""
    print(f"🧠 RUNNING: Simple chat inference for prompt: '{req.message[:50]}...'")
    # Re-use the existing Phi inference logic
    return execute_phi_inference(req.message, "")

