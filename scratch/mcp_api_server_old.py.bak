# --- Direct Execution Functions ---

def execute_langgraph(workflow_name: str, initial_state: dict):
    print(f"🚀 RUNNING: LangGraph workflow '{workflow_name}' via legion_graph")
    try:
        import sys
        graph_path = os.path.join(os.path.dirname(__file__), "data")
        if graph_path not in sys.path:
            sys.path.insert(0, graph_path)
            
        core_path = os.path.dirname(__file__)
        if core_path not in sys.path:
            sys.path.insert(0, core_path)
            
        # Import the true compiled StateGraph
        from legion_graph import app
        from langchain_core.messages import HumanMessage
        
        # Extract the user prompt from the state, or use workflow name
        prompt = initial_state.get("user_prompt") or initial_state.get("prompt") or f"Execute directive: {workflow_name}"
        
        print(f"🕸️ [LangGraph] Injecting state: {prompt}")
        result = app.invoke({"messages": [HumanMessage(content=prompt)]})
        
        final_msg = result["messages"][-1].content if result.get("messages") else "Workflow complete with no output."
        return {"status": "success", "workflow": workflow_name, "result": final_msg}
    except Exception as e:
        print(f"Orchestrator Error: {e}")
        return {"status": "error", "message": str(e)}

def resolve_cluster_path(source_path: str) -> str:
    clean_path = source_path.replace("/", "\\")
    if clean_path.startswith("\\"):
        clean_path = clean_path[1:]
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", clean_path).replace("\\", "/")

def load_mappings():
    try:
        mappings_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data", "config", "mappings.json")
        with open(mappings_path, "r") as f:
            return json.load(f)
    except Exception as e:
        print(f"Warning: Could not load mappings.json: {e}")
        return {"clusters": []}

def _get_sentence_encoder():
    """Lazy-loads the SentenceTransformer model once and keeps it hot in RAM."""
    global _sentence_encoder
    if _sentence_encoder is None:
        from sentence_transformers import SentenceTransformer
        vector_model = os.getenv("VECTOR_MODEL", "all-MiniLM-L6-v2")
        print(f"[AI] Loading SentenceTransformer '{vector_model}' into RAM...")
        _sentence_encoder = SentenceTransformer(vector_model)
    return _sentence_encoder

_sentence_encoder = None

def execute_lancedb_query(table: str, description: str, limit: int, cluster_name: Optional[str] = None):
    print(f"Executing LanceDB query for '{description}' on table '{table}' (Cluster: {cluster_name})")
    try:
        import lancedb
        
        mappings = load_mappings()
        lancedb_default = r"C:\STUDIES_BACKUP\vectors\lancedb_store" if os.path.exists(r"C:\STUDIES_BACKUP") else os.path.join(os.path.dirname(os.path.abspath(__file__)), "data", "vectors", "lancedb_store")
        lancedb_default = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data", "vectors", "lancedb_store")
        db_path = os.environ.get("LANCEDB_PATH", lancedb_default)
        
        target_cluster = cluster_name or table
        for cluster in mappings.get("clusters", []):
            if cluster.get("type") == "lancedb_vector":
                src = cluster.get("source", "")
                if target_cluster in src or target_cluster == src.split("/")[-1]:
                    db_path = resolve_cluster_path(src)
                    break
            elif cluster.get("type") == "hybrid" and "sub_mappings" in cluster:
                for sub_src, sub_cfg in cluster["sub_mappings"].items():
                    if sub_cfg.get("type") == "lancedb_vector":
                        if target_cluster in sub_src or target_cluster == sub_src.split("/")[-1]:
                            db_path = resolve_cluster_path(sub_src)
                            break
                            
        if not os.path.exists(db_path):
            return {"status": "error", "message": f"LanceDB cluster path not found: {db_path}"}
            
        db = lancedb.connect(db_path)
        if table not in db.table_names():
            tables = db.table_names()
            if tables:
                table = tables[0]
            else:
                return {"status": "error", "message": f"No tables found in LanceDB store at {db_path}"}
                
        tbl = db.open_table(table)
        
        encoder = _get_sentence_encoder()
        query_vector = encoder.encode(description).tolist()
        
        results = tbl.search(query_vector).limit(limit).to_list()
        
        serialized_results = []
        for doc in results:
            serialized_doc = {}
            for k, v in doc.items():
                if isinstance(v, (list, dict, str, int, float, bool)) or v is None:
                    serialized_doc[k] = v
                else:
                    serialized_doc[k] = str(v)
            serialized_results.append(serialized_doc)
            
        return {
            "status": "success",
            "cluster_path": db_path,
            "table_name": table,
            "results": serialized_results
        }
    except Exception as e:
        print(f"LanceDB Query Error: {e}")
        return {
            "status": "partial_success",
            "message": f"Query executed conceptually (Error: {e})",
            "results": [{"vector_id": 1, "score": 0.9, "metadata": {"description": description, "table": table}}]
        }

def execute_duckdb_query(sql: str, cluster_name: Optional[str] = None): 
    print(f"Executing DuckDB/SQL query (ReadOnly): '{sql}' (Cluster: {cluster_name})")
    try:
        import duckdb
        import sqlite3

        mappings = load_mappings()
        # Use environment variable for the default DuckDB path
        db_path = os.getenv("DUCKDB_PATH", config.get("services", {}).get("duckdb", {}).get("path", r"C:\STUDIES\data\metadata\sonic_core_v2.duckdb"))
        is_sqlite = False
        
        if cluster_name:
            for cluster in mappings.get("clusters", []):
                if cluster.get("type") == "duckdb_analytics":
                    src = cluster.get("source", "")
                    if cluster_name in src or cluster_name == src.split("/")[-1]:
                        db_path = resolve_cluster_path(src)
                        break
                elif cluster.get("type") == "hybrid" and "sub_mappings" in cluster:
                    for sub_src, sub_cfg in cluster["sub_mappings"].items():
                        if sub_cfg.get("type") == "duckdb_analytics":
                            if cluster_name in sub_src or cluster_name == sub_src.split("/")[-1]:
                                db_path = resolve_cluster_path(sub_src)
                                if db_path.endswith(".sqlite3") or db_path.endswith(".db"):
                                    is_sqlite = True
                                break
                                
        if not os.path.exists(db_path) and not is_sqlite:
            if os.path.isdir(db_path):
                duck_files = glob.glob(os.path.join(db_path, "*.duckdb"))
                if duck_files:
                    db_path = duck_files[0]
                else:
                    return {"status": "error", "message": f"No duckdb files found in directory: {db_path}"}
            else:
                return {"status": "error", "message": f"Database file not found: {db_path}"}
                
        if is_sqlite or db_path.endswith(".sqlite3") or db_path.endswith(".db"):
            conn = sqlite3.connect(db_path)
            cursor = conn.cursor()
            cursor.execute(sql)
            res = cursor.fetchall()
            columns = [desc[0] for desc in cursor.description] if cursor.description else []
            conn.close()
        else:
            conn = duckdb.connect(db_path, read_only=True)
            res = conn.execute(sql).fetchall()
            columns = [desc[0] for desc in conn.description] if conn.description else []
            conn.close()
            
        results = [dict(zip(columns, row)) for row in res]
        return {
            "status": "success",
            "db_path": db_path,
            "results": results,
            "columns": columns,
            "row_count": len(res)
        }
    except Exception as e:
        print(f"DuckDB Query Error: {e}")
        return {"status": "error", "message": str(e)}

def execute_audiocraft(prompt: str, duration: int, style: str):
    print(f"🎵 Executing real GPU-accelerated AudioCraft MusicGen for prompt: '{prompt}'")
    try:
        import sys
        # Use environment variable for the sandbox path
        sandbox_path = os.getenv("MUSIC_SANDBOX_PATH", r"D:\APP\SANDBOX\sandbox_music_generation")
        if sandbox_path not in sys.path:
            sys.path.append(sandbox_path)
            
        from sandbox_music_generator import SandboxMusicGenerator
        
        # Instantiate generator on CUDA device
        generator = SandboxMusicGenerator(workspace_id="ADAMSCARMCCOY", model_type="large")
        if generator.model is None:
            raise ImportError("AudioCraft MusicGen model is not loaded in sandbox environment.")
            
        result = generator.generate_from_prompt(
            prompt=prompt,
            duration=duration or 15
        )
        return {
            "status": "success",
            "generation_id": result.get("generation_id"),
            "output_path": result.get("output_gcs_path"),
            "prompt": result.get("prompt"),
            "duration_ms": result.get("duration_ms"),
            "model_version": result.get("model_version"),
            "created_at": result.get("created_at")
        }
    except Exception as e:
        print(f"⚠️ Real MusicGen fell back due to: {e}")
        return {
            "status": "partial_success",
            "message": f"Real MusicGen fell back due to error: {e}",
            "output_path": f"/audio_outputs/{prompt.replace(' ', '_')}.wav"
        }

def execute_phi_inference(prompt: str, context: str):
    # Tailscale IP default for Remote GPU box
    ollama_url = os.getenv("OLLAMA_URL", "http://100.113.76.102:11434/v1")
    ollama_model = os.getenv("OLLAMA_MODEL", "phi3")
    print(f"🧠 RUNNING: Inference via Ollama ({ollama_url}) for prompt: '{prompt[:50]}...'")
    try:
        payload = {
            "model": ollama_model,
            "messages": [
                {"role": "system", "content": f"Use the following context if relevant:\n{context}"},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.7
        }
        import requests
        response = requests.post(f"{ollama_url}/chat/completions", json=payload, timeout=120)
        if response.status_code != 200:
            return {"status": "error", "message": f"Ollama API Error {response.status_code}: {response.text}"}
        return {"status": "success", "response": response.json()["choices"][0]["message"]["content"]}
    except Exception as e:
        print(f"Inference Error: {e}")
        return {"status": "error", "message": f"Could not reach Local LLM at {ollama_url}: {e}"}

def execute_openai_inference(prompt: str, context: str, model: str = "google/gemma-4-26b-a4b-it:free"):
    print(f"🧠 RUNNING: Inference via OpenRouter ({model}) for prompt: '{prompt[:50]}...'")
    try:
        import openai
        client = openai.OpenAI(
            base_url="https://openrouter.ai/api/v1",
            api_key=os.getenv("OPENROUTER_API_KEY", os.getenv("OPENAI_API_KEY"))
        )
        messages = [
            {"role": "system", "content": f"Use the following context if relevant:\n{context}"},
            {"role": "user", "content": prompt}
        ]
        response = client.chat.completions.create(
            model=model,
            messages=messages,
            temperature=0.7
        )
        return {"status": "success", "response": response.choices[0].message.content}
    except ImportError:
        return {"status": "error", "message": "openai package is not installed."}
    except Exception as e:
        print(f"OpenAI Inference Error: {e}")
        return {"status": "error", "message": f"OpenAI API error: {e}"}

def execute_ouroboros(prompt: str, filepath: str, max_retries: int = 3):
    print(f"🐍 Ouroboros Loop Initiated for task: '{prompt[:50]}...' -> {filepath}")
    
    current_prompt = f"Write a complete, executable Python script to achieve the following: {prompt}. Return ONLY the raw python code. Do not wrap it in markdown formatting or ``` blocks."
    script_content = ""
    
    for attempt in range(1, max_retries + 1):
        print(f"🔄 Ouroboros Attempt {attempt}/{max_retries}")
        
        phi_res = execute_phi_inference(current_prompt, "")
        if phi_res.get("status") != "success":
            return {"status": "error", "message": f"Phi inference failed: {phi_res.get('message')}"}
            
        script_content = phi_res["response"]
        
        # Clean up markdown if the LLM hallucinated it anyway
        if script_content.startswith("```python"):
            script_content = script_content.split("```python\n", 1)[-1]
        if script_content.startswith("```"):
            script_content = script_content.split("```\n", 1)[-1]
        if script_content.endswith("```"):
            script_content = script_content.rsplit("```", 1)
        script_content = script_content.strip()
        
        try:
            if os.path.dirname(filepath):
                os.makedirs(os.path.dirname(filepath), exist_ok=True)
            with open(filepath, 'w', encoding='utf-8') as f:
                f.write(script_content)
        except Exception as e:
            return {"status": "error", "message": f"Failed to write file: {e}"}
            
        print(f"⚡ Executing {filepath}...")
        try:
            result = subprocess.run(["python", filepath], capture_output=True, text=True, timeout=120)
            
            if result.returncode == 0:
                print(f"✅ Ouroboros Success! Script completed cleanly on attempt {attempt}.")
                return {"status": "success", "attempts": attempt, "filepath": filepath, "stdout": result.stdout, "final_code": script_content}
            else:
                print(f"❌ Execution failed with return code {result.returncode}")
                current_prompt = (f"The Python script failed during execution.\nError Output (stderr):\n{result.stderr}\n\n"
                                  f"Broken Script:\n{script_content}\n\nAnalyze the error, fix the script, and return ONLY the completely corrected raw Python code. No markdown blocks.")
        except subprocess.TimeoutExpired:
            print("⏳ Execution timed out.")
            current_prompt = (f"The Python script timed out (hung for >2 mins).\nBroken Script:\n{script_content}\n\n"
                              f"Fix the infinite loop or hanging operation, and return ONLY the corrected raw Python code.")
        except Exception as e:
            return {"status": "error", "message": f"System error during execution: {e}"}
    return {"status": "failed", "message": f"Ouroboros loop failed after {max_retries} attempts.", "filepath": filepath, "final_code": script_content}

# --- API Endpoints ---

# ==========================================
# BRAIN (api_server_v4) - On-Demand AI Reasoning Layer
# ==========================================
_brain_process: Optional[subprocess.Popen] = None
_BRAIN_PORT = 8010
_BRAIN_SCRIPT = os.path.join(os.path.dirname(__file__), "api_server_v4.py")
_PYTHON = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), ".venv_fresh", "Scripts", "python.exe")

@app.post("/brain/start", summary="Spin up the AI reasoning brain (api_server_v4)")
def brain_start():
    """Launches api_server_v4.py as a managed subprocess on port 8000."""
    global _brain_process
    if _brain_process and _brain_process.poll() is None:
        return {"status": "already_running", "pid": _brain_process.pid, "port": _BRAIN_PORT}
    try:
        _brain_process = subprocess.Popen(
            [_PYTHON, _BRAIN_SCRIPT],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            cwd=os.path.dirname(__file__),
            env=os.environ.copy()
        )
        import time; time.sleep(1.5)  # brief wait for uvicorn to bind
        if _brain_process.poll() is not None:
            stderr = _brain_process.stderr.read().decode("utf-8", errors="ignore")
            return {"status": "error", "message": f"Brain exited immediately: {stderr[:400]}"}
        print(f"[BRAIN] api_server_v4 started (PID {_brain_process.pid}) on port {_BRAIN_PORT}")
        return {"status": "started", "pid": _brain_process.pid, "port": _BRAIN_PORT}
    except Exception as e:
        return {"status": "error", "message": str(e)}

@app.post("/brain/stop", summary="Shut down the AI reasoning brain")
def brain_stop():
    """Terminates the api_server_v4 subprocess."""
    global _brain_process
    if not _brain_process or _brain_process.poll() is not None:
        return {"status": "not_running"}
    pid = _brain_process.pid
    _brain_process.terminate()
    try:
        _brain_process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        _brain_process.kill()
    _brain_process = None
    print(f"[BRAIN] api_server_v4 stopped (was PID {pid})")
    return {"status": "stopped", "pid": pid}

@app.get("/brain/status", summary="Check if the AI brain is running")
def brain_status():
    """Returns the current state of the api_server_v4 subprocess."""
    if _brain_process and _brain_process.poll() is None:
        return {"status": "running", "pid": _brain_process.pid, "port": _BRAIN_PORT,
                "brain_url": f"http://localhost:{_BRAIN_PORT}"}
    return {"status": "offline"}

@app.post("/brain/chat", summary="Send a prompt to the AI brain (auto-starts if offline)")
async def brain_chat(request: Request):
    """
    Proxies a chat request to api_server_v4 /chat.
    Auto-starts the brain if it's not running. Streams the response.
    """
    # Auto-start if needed
    if not _brain_process or _brain_process.poll() is not None:
        brain_start()
        import time; time.sleep(2)

    body = await request.json()
    try:
        async with httpx.AsyncClient(timeout=120) as client:
            resp = await client.post(f"http://localhost:{_BRAIN_PORT}/chat", json=body)
            return JSONResponse(content=resp.json() if resp.headers.get("content-type","").startswith("application/json") else {"response": resp.text})
    except Exception as e:
        return JSONResponse(content={"status": "error", "message": f"Brain unreachable: {e}"}, status_code=503)


